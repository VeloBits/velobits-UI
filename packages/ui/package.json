      "limit": "2 kB",
      "ignore": [
        "react",
        "react-dom",
        "framer-motion",
        "@velobitsio/icons",
        "@velobitsio/tokens",
        "radix-ui",
        "class-variance-authority",
        "clsx",
        "tailwind-merge"
      ]
    },
    {
      "name": "the whole barrel, our code only (40 components, minus the 2 subpath-only ones)",
      "path": "dist/index.js",
      "limit": "32 kB",
      "ignore": [
        "react",
        "react-dom",
        "framer-motion",
        "@velobitsio/icons",
        "@velobitsio/tokens",
        "radix-ui",
        "class-variance-authority",
        "clsx",
        "tailwind-merge"
      ]
    },
    {
      "name": "the whole barrel, with every dependency (what a consumer pays; 64 kB at T3, 68 kB before Slider)",
      "path": "dist/index.js",
      "limit": "72 kB",
      "ignore": [
        "react",
