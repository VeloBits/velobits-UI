  "size-limit": [
    {
      "name": "Button alone, our code only (proves per-entry tree-shaking)",
      "path": "dist/button.js",
      "limit": "2 kB",
      "ignore": [
        "react",
        "react-dom",
        "framer-motion",
        "@velobitsio/icons",
        "@velobitsio/tokens",
        "radix-ui",
        "class-variance-authority",
        "clsx",
        "tailwind-merge"
      ]
    },
    {
      "name": "Dialog alone, our code only (the overlay tier's per-entry proof)",
