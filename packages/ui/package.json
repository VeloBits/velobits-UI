      "limit": "3 kB",
      "ignore": [
        "react",
        "react-dom",
        "framer-motion",
        "@velobitsio/icons",
        "@velobitsio/tokens",
        "radix-ui",
        "class-variance-authority",
        "clsx",
        "tailwind-merge"
      ]
    },
    {
