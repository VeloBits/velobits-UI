{
  "name": "@velobits/ui",
  "version": "0.1.0",
  "description": "VeloBits shared React components. Built from registry/velobits, the same source the shadcn CLI serves.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VeloBits/velobits-UI.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
