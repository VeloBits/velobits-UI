  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "size-limit",
    "publint": "publint",
    "attw": "attw --pack . --profile node16",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.6.7",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "@velobits/icons": "^0.1.0",
    "@velobits/tokens": "^0.1.0",
    "framer-motion": ">=12.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@velobits/icons": "*",
    "@velobits/tokens": "*",
    "axe-core": "^4.12.1",
    "framer-motion": "^12.43.0",
    "happy-dom": "^20.11.1",
    "publint": "^0.3.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "size-limit": "^13.0.3",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  },
  "size-limit": [
    {
      "name": "Button alone, our code only (proves per-entry tree-shaking)",
      "path": "dist/button.js",
      "limit": "2 kB",
      "ignore": [
        "react",
        "react-dom",
        "framer-motion",
        "@velobits/icons",
        "@velobits/tokens",
        "radix-ui",
        "class-variance-authority",
        "clsx",
        "tailwind-merge"
      ]
    },
    {
      "name": "the whole barrel, our code only",
      "path": "dist/index.js",
      "limit": "6 kB",
      "ignore": [
        "react",
        "react-dom",
        "framer-motion",
        "@velobits/icons",
        "@velobits/tokens",
        "radix-ui",
        "class-variance-authority",
        "clsx",
        "tailwind-merge"
      ]
    },
    {
      "name": "the whole barrel, with every dependency (what a consumer pays)",
      "path": "dist/index.js",
      "limit": "36 kB",
      "ignore": [
        "react",
        "react-dom"
      ]
    }
  ]
}
