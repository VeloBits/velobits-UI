# NOT ignored, deliberately:
#   registry.json             the shadcn CLI manifest. Generated from
#                             registry/registry.ts, but committed so the repo is
#                             installable from a clone without a build step.
#   apps/docs/public/r/*.json the compiled registry the CLI actually fetches.
#                             Committed for the same reason — and because the
#                             docs deploy serves these as static files.
