# deps / build
node_modules/
dist/
.turbo/
coverage/
*.tsbuildinfo

# Next.js: build output, and the ambient types it regenerates on every build.
.next/
next-env.d.ts

# The static export , the whole deployable, docs and /r together.
apps/docs/out/

# Codegen for the docs site: example sources, prop tables, registry metadata.
# Written by `scripts/build-docs-data.ts`, which BOTH `dev` and `build` run first,
# so a clean clone never sees it missing. Not committed because every byte of it
# is derived from files that are , and because it embeds ~40 component sources
# verbatim, which would make every component edit a two-file diff.
apps/docs/lib/generated/
apps/docs/public/search-index.json

# env - keep .env.example tracked
.env
.env.*
!.env.example

# misc
*.log
.DS_Store
.playwright-mcp/

.claude*
*db*
*swarm*

# NOT ignored, deliberately:
#   registry.json             the shadcn CLI manifest. Generated from
#                             registry/registry.ts, but committed so the repo is
#                             installable from a clone without a build step.
#   apps/docs/public/r/*.json the compiled registry the CLI actually fetches.
#                             Committed for the same reason , and because the
#                             docs deploy serves these as static files.

.vercel
