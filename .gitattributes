# Normalise line endings to LF in the repository. CRLF reaching a Linux
# container produces errors that look nothing like a line-ending problem:
#   Dockerfile with CRLF  → exec /bin/sh: no such file or directory
#   *.sh with CRLF        → $'\r': command not found
* text=auto eol=lf

Dockerfile*  text eol=lf
*.sh         text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf

# The neutral ramp is generated by scripts/generate-neutrals.ts. Marking it
# linguist-generated keeps it collapsed in diffs, which is the reminder that
# hand-editing it is wrong — regenerate instead.
packages/tokens/src/generated/**  linguist-generated=true
