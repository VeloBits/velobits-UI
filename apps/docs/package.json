{
  "name": "@velobits/docs",
  "version": "0.0.0",
  "private": true,
  "description": "VeloBits design system docs. Also the registry host: /r/*.json is what the shadcn CLI fetches.",
  "type": "module",
  "scripts": {
    "docs:data": "tsx ../../scripts/build-registry.ts && tsx ../../scripts/build-docs-data.ts",
    "dev": "npm run docs:data && next dev --port 4100",
    "build": "npm run docs:data && next build && tsx ../../scripts/flatten-prefetch-payloads.ts",
    "start": "serve out --listen 4100",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .next out lib/generated .turbo"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.0",
    "@velobits/icons": "*",
    "@velobits/tokens": "*",
    "@velobits/ui": "*",
    "framer-motion": "^12.43.0",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "serve": "^14.2.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3"
  }
}
