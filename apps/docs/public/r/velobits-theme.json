{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "velobits-theme",
  "title": "VeloBits theme",
  "description": "The full token layer as CSS variables. Every colour pair here is contrast-verified in both themes by the @velobits-dev/tokens test suite.",
  "cssVars": {
    "theme": {
      "radius-sm": "4px",
      "radius-md": "6px",
      "radius-lg": "10px",
