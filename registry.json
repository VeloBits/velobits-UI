          "container-page": "72rem",
          "duration-micro": "120ms",
          "duration-enter": "180ms",
          "duration-overlay": "240ms",
          "duration-page": "320ms",
          "ease-out": "cubic-bezier(0.32, 0.72, 0, 1)",
