# @velobits/* is published to GitHub Packages (private).
#
# Only the registry mapping lives here. The auth line does NOT, deliberately:
# npm hard-fails on an unresolvable `${VAR}` in .npmrc, so committing
# `//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}` breaks a plain
# `npm install` for anyone without the variable exported — including this repo,
# which needs no token of its own (every @velobits/* dep here is a workspace
# link, resolved locally and never fetched).
#
# Where the token comes from instead:
#   CI       actions/setup-node with `registry-url` writes the auth line into a
#            temporary .npmrc; the job needs `permissions: packages: write`.
#   local    `npm config set //npm.pkg.github.com/:_authToken <PAT>` in ~/.npmrc
#   consumer Docker builds: a BuildKit secret
#            (`RUN --mount=type=secret,id=npmrc`), NEVER an ARG — an ARG is
#            recorded in the image history.
@velobits:registry=https://npm.pkg.github.com

# GitHub Packages has no attestation endpoint, so npm's provenance signing
# fails the publish outright. Off explicitly, not by default, so a future npm
# flipping the default cannot break `changeset publish`.
provenance=false

# Do NOT add legacy-peer-deps here. FixMyText's ADR-0006 records why: the root
# `overrides` that pin React/TypeScript are silently disabled by it, and this
# repo is what those consumers resolve their peers against.
